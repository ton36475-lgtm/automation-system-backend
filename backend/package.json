{
  "name": "automation-system-backend",
  "version": "1.0.0",
  "description": "Full-Stack Automation + Analytics System - Backend Services",
  "main": "api-gateway.js",
  "scripts": {
    "start": "node api-gateway.js",
    "dev": "nodemon api-gateway.js",
    "start:automation": "node automation-service.js",
    "start:analytics": "node analytics-service.js",
    "start:dashboard": "node dashboard-service.js",
    "dev:automation": "nodemon automation-service.js",
    "dev:analytics": "nodemon analytics-service.js",
    "dev:dashboard": "nodemon dashboard-service.js",
    "start:all": "concurrently \"npm run start\" \"npm run start:automation\" \"npm run start:analytics\" \"npm run start:dashboard\"",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:automation\" \"npm run dev:analytics\" \"npm run dev:dashboard\"",
    "db:init": "psql -U postgres -d automation_db -f ../database-schema.sql",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "automation",
    "analytics",
    "dashboard",
    "workflow",
    "orchestration"
  ],
  "author": "Manus AI",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^6.7.0",
    "morgan": "^1.10.0",
    "jsonwebtoken": "^9.0.0",
    "axios": "^1.4.0",
    "pg": "^8.11.0",
    "redis": "^4.6.0",
    "uuid": "^9.0.0",
    "dotenv": "^16.0.3",
    "joi": "^17.9.0",
    "winston": "^3.8.0",
    "socket.io": "^4.6.0",
    "bull": "^4.11.0",
    "temporal-sdk": "^1.8.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.20",
    "concurrently": "^8.0.1",
    "jest": "^29.5.0",
    "supertest": "^6.3.3",
    "eslint": "^8.40.0",
    "prettier": "^2.8.8"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
